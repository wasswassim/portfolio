# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Google service-account keys: keep them outside the repo (e.g. ~/.secrets/);
# scripts/check-secrets.mjs fails the build if one is ever committable
/secrets/
*service-account*.json
wassimgatri-seo-*.json
*.key.json

# SEO opportunity reports (scripts/seo), uploaded as CI artifacts instead
/reports/seo/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
